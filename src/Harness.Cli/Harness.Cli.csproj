<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Harness.Client\Harness.Client.csproj" />
    <ProjectReference Include="..\Harness.Tui\Harness.Tui.csproj" />
    <!-- Local commands (init, trust, secrets, models doctor) work on the harness home without a daemon. -->
    <ProjectReference Include="..\Harness.Runs\Harness.Runs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harness.Tests" />
  </ItemGroup>
  <!-- Release builds (.github/workflows/release.yml) record where 'harness update' finds the next release and the key it is signed with. -->
  <ItemGroup>
    <AssemblyMetadata Include="HarnessUpdateRepository" Value="$(HarnessUpdateRepository)" Condition="'$(HarnessUpdateRepository)' != ''" />
    <AssemblyMetadata Include="HarnessUpdatePublicKey" Value="$(HarnessUpdatePublicKey)" Condition="'$(HarnessUpdatePublicKey)' != ''" />
  </ItemGroup>
</Project>
